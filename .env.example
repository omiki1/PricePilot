# PricePilot 环境变量模板
#
# 用法：复制为 .env 并填写真实值。.env 已被 .gitignore 忽略，不会提交。
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)

# ============================================================
# 模型（兼容 OpenAI 协议的任意服务商）
# ============================================================
# 代码按下面的顺序回退，取第一个非空的：
#   模型名   LINE_MODEL_NAME    -> MAIN_MODEL_NAME    -> MODEL_LINE_NAME
#   API Key  LINE_MODEL_API_KEY -> MAIN_MODEL_API_KEY -> COMMANDCODE_API_KEY
#   端点     LINE_MODEL_BASE_URL-> MAIN_MODEL_BASE_URL-> OPENAI_API_BASE
LINE_MODEL_NAME=
LINE_MODEL_API_KEY=
LINE_MODEL_BASE_URL=

# 自查当前生效的模型配置（不回显密钥明文）：
#     python -c "from app.ai.model.my_model import describe; print(describe())"
MODEL_NAME=

# ============================================================
# Redis —— L1 窗口记忆、L4 用户画像、首页推荐缓存
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Redis 若开了 requirepass 必须填，否则连接会报 AuthenticationError
REDIS_PASSWORD=

# L1 窗口保留的消息条数（user 与 ai 各算一条，40 即最近 20 轮）
WINDOW_MEMORY_ROUNDS=40
# L1 窗口过期秒数（默认 1 天）
WINDOW_MEMORY_TIME=86400

# ============================================================
# PostgreSQL —— L2 会话摘要、LangGraph checkpoint
# ============================================================
POSTGRESQL_URL=host=127.0.0.1 port=5432 dbname=postgres user=postgres password=

# ============================================================
# MySQL —— 用户账号、收藏夹、价格历史
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pricepilot
MYSQL_CHARSET=utf8mb4

# ============================================================
# ChromaDB（L3 长期记忆向量库，嵌入式，无需单独启动服务）
# ============================================================
# 持久化目录；.gitignore 已忽略 chroma_data/
CHROMA_PATH=./chroma_data

# 本地嵌入模型路径。留空则退回 Chroma 自带的英文模型（all-MiniLM-L6-v2），
# 中文语义区分度较差，且首次使用会联网下载约 79MB。
# 推荐下载 BAAI/bge-base-zh-v1.5 后指向其目录。
EMBEDDING_LOCAL_PATH=
EMBEDDING_DEVICE=cpu

# ============================================================
# 注册邮箱验证码（SMTP）
# ============================================================
SENDER_EMAIL=
SENDER_EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
